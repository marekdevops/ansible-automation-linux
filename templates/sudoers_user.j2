# Sudoers file for {{ sudoers_mode }}: {{ sudoers_subject }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
#
# This file allows {{ sudoers_subject }} to execute specific commands without password
#

# {{ 'Group' if sudoers_mode == 'group' else 'User' }} privilege specification
{% for command_line in sudoers_commands %}
{% if command_line.strip() and not command_line.strip().startswith('#') %}
{% set commands = command_line.split(';') %}
{% for command in commands %}
{% if command.strip() %}
{{ sudoers_subject_prefix }}{{ sudoers_subject }} ALL=(ALL) NOPASSWD: {{ command.strip() }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}