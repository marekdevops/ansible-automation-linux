# Sudoers file for {{ sudoers_mode }}: {{ sudoers_subject }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
#
{% if sudoers_target_user_mode %}
# This file allows {{ sudoers_subject }} to switch to user {{ sudoers_target_user }}
#

# Switch to {{ sudoers_target_user }} via sudo su -
{{ sudoers_subject_prefix }}{{ sudoers_subject }} ALL=(root) NOPASSWD: /bin/su - {{ sudoers_target_user }}, /usr/bin/su - {{ sudoers_target_user }}
{% else %}
# This file allows {{ sudoers_subject }} to execute specific commands without password
#

# {{ 'Group' if sudoers_mode in ['group', 'groupldap'] else 'User' }} privilege specification
{% for command_line in sudoers_commands %}
{% if command_line.strip() and not command_line.strip().startswith('#') %}
{% set commands = command_line.split(';') %}
{% for command in commands %}
{% if command.strip() %}
{{ sudoers_subject_prefix }}{{ sudoers_subject }} ALL=(ALL) NOPASSWD: {{ command.strip() }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
